fn parse_port(raw: String) -> Result[Int, String] = {
  let n = int.parse(raw) ?? -1
  if n < 1 or n > 65535 then err("not a port: ${raw}")
  else ok(n)
}

effect fn main() -> Result[Unit, String] = {
  for raw in ["8080", "443"] {
    let port = parse_port(raw)!
    println("port ${int.to_string(port)} ok")
  }
}

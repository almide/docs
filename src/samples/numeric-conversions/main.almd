fn label(name: String, o: Option[Int8]) -> String =
  match o {
    some(v) => name + " = some(" + v.to_string() + ")",
    none => name + " = none",
  }

fn main() -> Unit = {
  // Sized values are made with a type annotation — there is no `42i8` suffix.
  let byte: UInt8 = 255
  let word: UInt32 = 4294967295
  println("UInt8 max  = " + byte.to_string())
  println("UInt32 max = " + word.to_string())

  // A conversion is named after the type it builds.
  // from_wrapping keeps the low bits (two's complement).
  println("int8.from_wrapping(300)     = " + int8.from_wrapping(300).to_string())

  // from_checked reports the loss instead: Option[T], none when it would not fit.
  println(label("int8.from_checked(127)", int8.from_checked(127)))
  println(label("int8.from_checked(128)", int8.from_checked(128)))

  // from_saturating clamps to the type's range.
  println("int8.from_saturating(999)   = " + int8.from_saturating(999).to_string())

  // Float -> integer truncates toward zero first; NaN saturates to 0.
  println("int8.from_saturating(-3.7)  = " + int8.from_saturating(-3.7).to_string())
  println(label("int8.from_checked(9.5)", int8.from_checked(9.5)))

  // Back to Int is the destination's `from`.
  let small: Int8 = 42
  println("int.from(small)             = " + int.to_string(int.from(small)))
}

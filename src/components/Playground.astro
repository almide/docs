---
/**
 * A runnable code sample.
 *
 * The sample itself lives in `src/samples/<id>/` as real `.almd` files — NOT
 * inline in the page. That matters for more than tidiness: MDX rewrites the
 * indentation of multi-line template literals, so code pasted into a JSX
 * attribute reaches the reader reindented, and `${…}` has to be escaped by
 * hand. Files on disk are shipped byte-for-byte, and `check:embeds` asserts
 * exactly that.
 *
 * The pre-Run state deliberately imitates the playground it turns into: same
 * dark surface, same slim bar, same file tab, same height. Pressing Run swaps
 * the interior for the live iframe, so the frame appears to stay put and only
 * the contents come alive — rather than a page-themed code block being
 * replaced by a full dark IDE that is a different size.
 *
 * The iframe is created ONLY on click: each one loads the compiler wasm, so
 * eagerly embedding several per page would be costly. At most one runs at a
 * time; opening another closes the previous.
 *
 * Usage:
 *   <Playground sample="hello-basic" />
 *   <Playground sample="modules-two-files" height={560} hide={['fixtures.almd']} />
 */
import { Code } from 'astro:components';
import { playgroundUrl, type PlaygroundFile } from '../lib/playground';
import almideGrammar from '../almide.tmLanguage.json';
import { playgroundTheme } from '../lib/playground-theme';

// Astro's <Code> runs its own Shiki instance, separate from markdown.shikiConfig,
// so the grammar has to be handed to it directly.
const almideLang = { ...almideGrammar, name: 'almide' } as any;

interface Props {
  /** Directory name under `src/samples/`. */
  sample: string;
  /** Tabs hidden from the strip but still compiled (setup code). */
  hide?: string[];
  /** Height of the playground frame once opened. */
  height?: number;
}

const { sample, hide = [], height = 520 } = Astro.props;

// Eager raw import: the sample sources are inlined at build time, exactly as
// they are on disk.
const sources = import.meta.glob('../samples/**/*', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

const prefix = `../samples/${sample}/`;
const entries = Object.entries(sources).filter(([path]) => path.startsWith(prefix));
if (entries.length === 0) {
  throw new Error(
    `<Playground sample="${sample}"> — no files found in src/samples/${sample}/`,
  );
}

// `main.almd` is the entry point and must come first; the rest keep a stable
// (alphabetical) order so the encoded link is deterministic across builds.
const files: PlaygroundFile[] = entries
  .map(([path, content]) => ({ name: path.slice(prefix.length), content }))
  .sort((a, b) =>
    a.name === 'main.almd' ? -1 : b.name === 'main.almd' ? 1 : a.name.localeCompare(b.name),
  );

if (!files.some((f) => f.name === 'main.almd')) {
  throw new Error(`<Playground sample="${sample}"> — src/samples/${sample}/main.almd is required`);
}

const url = playgroundUrl(files, { hide });
const visible = files.filter((f) => !hide.includes(f.name));
const preview = visible[0] ?? files[0];
---

<div
  class="playground"
  data-playground-url={url}
  data-playground-height={height}
  data-playground-sample={sample}
  style={`--pg-height: ${height}px`}
>
  <div class="playground-preview">
    <div class="playground-bar">
      <span class="playground-brand">Almide</span>
      <button type="button" class="playground-run">Run</button>
    </div>
    <div class="playground-tabs">
      {visible.map((f) => (
        <span class:list={['playground-tab', f.name === preview.name && 'active']}>{f.name}</span>
      ))}
    </div>
    <div class="playground-code">
      <Code code={preview.content.trimEnd()} lang={almideLang} theme={playgroundTheme as any} />
    </div>
    <div class="playground-hint">Press Run to compile and execute this in your browser</div>
  </div>
</div>

<style>
  .playground {
    margin: 1rem 0;
    height: var(--pg-height);
    border: 1px solid #22344a;
    border-radius: 0.5rem;
    overflow: hidden;
    background: #0b1420;
  }
  .playground-preview {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  /* An author `display` rule beats the UA stylesheet's `[hidden] { display: none }`,
     so the attribute has to be honoured explicitly or the preview never goes away. */
  .playground-preview[hidden] {
    display: none;
  }

  /* Mirrors the playground's own embed bar. */
  .playground-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 12px;
    background: #101b29;
    border-bottom: 1px solid #22344a;
    flex: none;
  }
  .playground-brand {
    font-size: 12px;
    font-weight: 600;
    color: #a3b3c2;
    letter-spacing: 0.04em;
  }
  .playground-run {
    margin-left: auto;
    padding: 4px 14px;
    font-size: 11px;
    font-weight: 500;
    font-family: var(--sl-font);
    color: #fff;
    background: #0e7e86;
    border: 1px solid #14a2a2;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s, box-shadow 0.15s;
  }
  .playground-run:hover {
    background: #096578;
    box-shadow: 0 0 20px rgba(20, 162, 162, 0.2);
  }

  .playground-tabs {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px 12px;
    background: #101b29;
    border-bottom: 1px solid #22344a;
    min-height: 37px;
    flex: none;
  }
  .playground-tab {
    padding: 4px 10px;
    border-radius: 5px;
    font-family: var(--sl-font-mono, monospace);
    font-size: 11.5px;
    color: #6b7f93;
    white-space: nowrap;
  }
  .playground-tab.active {
    background: #1a2a3d;
    color: #f4f7f8;
    border: 1px solid #2b4058;
  }

  .playground-code {
    flex: 1;
    overflow: auto;
    min-height: 0;
  }
  /* The sample renders on the playground's surface, not the page's, so the
     before/after swap does not change colour scheme mid-interaction. */
  /* Font, size and line height are the playground editor's, so the glyphs do
     not change shape or reflow when the live version takes over. */
  .playground-code :global(pre) {
    margin: 0;
    padding: 14px 0;
    background: #0b1420 !important;
    border: none;
    border-radius: 0;
    font-family: var(--sl-font-mono);
    font-size: 13px;
    line-height: 1.7;
    counter-reset: pg-line;
  }
  .playground-code :global(code) {
    background: transparent;
    font-family: inherit;
  }
  /* CodeMirror renders a line-number gutter; mirror it so the columns line up. */
  .playground-code :global(.line) {
    counter-increment: pg-line;
  }
  .playground-code :global(.line)::before {
    content: counter(pg-line);
    display: inline-block;
    width: 2.5em;
    margin-right: 0.9em;
    padding-right: 0.35em;
    text-align: right;
    color: #6b7f93;
    user-select: none;
  }

  .playground-hint {
    flex: none;
    padding: 5px 12px;
    background: #101b29;
    border-top: 1px solid #22344a;
    font-size: 11px;
    color: #6b7f93;
    letter-spacing: 0.02em;
  }

  /* `margin: 0` is load-bearing. Starlight spaces adjacent markdown children
     with `* + *` → `margin-top: 1rem`, and the iframe is inserted as a sibling
     of the preview, so it inherits that 16px. In a fixed-height, overflow-hidden
     box that pushes the frame down and clips an equal strip off the bottom —
     which is exactly where the playground's mobile action bar (Run) sits when
     the frame is narrower than 768px, as it always is in the docs column. */
  .playground :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    border: none;
    background: #0b1420;
  }
</style>

<script>
  // One shared handler for every <Playground> on the page.
  let openFrame: HTMLElement | null = null;

  function closeFrame(root: HTMLElement) {
    const preview = root.querySelector<HTMLElement>('.playground-preview');
    const frame = root.querySelector('iframe');
    if (preview && frame) {
      frame.remove();
      preview.hidden = false;
    }
  }

  document.querySelectorAll<HTMLElement>('.playground').forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>('.playground-run');
    if (!button) return;

    button.addEventListener('click', () => {
      const url = root.dataset.playgroundUrl;
      if (!url) return;

      // Only one compiler instance at a time — each frame loads several MB.
      if (openFrame && openFrame !== root) closeFrame(openFrame);

      const preview = root.querySelector<HTMLElement>('.playground-preview');
      if (preview) preview.hidden = true;

      const iframe = document.createElement('iframe');
      iframe.src = url;
      iframe.title = 'Almide playground';
      root.appendChild(iframe);
      openFrame = root;
    });
  });
</script>

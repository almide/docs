---
import config from 'virtual:starlight/user-config';
import mark from '../assets/almide-symbol.svg';
import markDark from '../assets/almide-symbol-white.svg';
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<div class="header-row">
  <a href={siteTitleHref} class="site-title sl-flex">
    <img class="mark mark-light" alt="" src={mark.src} width="28" height="28" />
    <img class="mark mark-dark" alt="" src={markDark.src} width="28" height="28" />
    <span class="label" translate="no">{siteTitle}</span>
  </a>
  <span class="subtitle">Docs</span>
</div>

<style>
  .header-row {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .site-title {
    align-items: center;
    gap: 10px !important;
    text-decoration: none !important;
    white-space: nowrap;
    min-width: 0;
    view-transition-name: site-title;
  }
  /* The brand guideline forbids recolouring the shell, so the mark is shown as
     delivered: brand colours on light, the white reverse on dark. */
  .mark {
    width: 28px !important;
    height: 28px !important;
    flex-shrink: 0;
  }
  .mark-light { display: none; }
  :global(:root[data-theme='light']) .mark-light { display: block; }
  :global(:root[data-theme='light']) .mark-dark { display: none; }
  .label {
    font-size: 17px !important;
    font-weight: 600 !important;
    letter-spacing: 0.04em !important;
    overflow: hidden;
  }
  .subtitle {
    font-size: 12px;
    color: #8a9bab;
    letter-spacing: 0.02em;
  }
  :global(:root[data-theme='light']) .subtitle {
    color: #5a6b7d;
  }
</style>
